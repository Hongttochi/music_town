# Supabase Project URL and PUBLIC publishable key only.
# Never put service_role, sb_secret_, Google/Kakao client secrets in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel server-only environment variables. NEVER prefix these keys with VITE_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Account deletion: server-only Supabase Secret key (or legacy SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=

# Guardian consent rollout: configure provider + apply SQL before enabling both flags.
VITE_GUARDIAN_CONSENT_ENABLED=false
GUARDIAN_CONSENT_ENABLED=false
APP_ORIGIN=https://music-town-hb2j.vercel.app
# Random server-only value, at least 32 characters. Do not rotate without a migration plan.
ADMISSION_HASH_SECRET=
# PortOne V2 LIVE identity verification contract. Never use a payment-only or TEST channel.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
