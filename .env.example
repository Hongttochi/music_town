# Supabase Project URL and PUBLIC publishable key only.
# Never put service_role, sb_secret_, Google/Kakao client secrets in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Amplitude public ingestion key for the US project. Never use a Secret Key here.
# Set in .env.local and in the deployment build environment.
VITE_AMPLITUDE_API_KEY=

# Vercel server-only environment variables. NEVER prefix these keys with VITE_.
ADMIN_EMAILS=
# Comma-separated verified login emails, e.g. admin@example.com,owner@example.com.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Account deletion: server-only Supabase Secret key (or legacy SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=

# Browser opt-in flag only. Set true after configuring the server below, then rebuild.
VITE_LOGGING_ENABLED=false
# Logflare server-only source-scoped ingestion token and Source UUID (never VITE_*).
LOGFLARE_API_KEY=
LOGFLARE_SOURCE_ID=
# Admin monitoring: authenticated Logflare Endpoint name/UUID and query-scoped token.
# Separate from the ingestion token above. See docs/admin-monitoring.md.
LOGFLARE_QUERY_ENDPOINT=
LOGFLARE_QUERY_API_KEY=
# Exact frontend origins, comma separated. No wildcard or trailing slash.
LOG_ALLOWED_ORIGINS=https://music-town-hb2j.vercel.app

# Local admin demo only: Amplitude embed link shown on the Amplitude page. Never set this in Vercel.
VITE_DEMO_AMPLITUDE_EMBED=
